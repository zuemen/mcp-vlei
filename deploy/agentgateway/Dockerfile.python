# One image for both Python services of the regulator scenario: filing-server and vlei-authz.
#
# Build context is the repository root (see docker-compose.yml). What is sent to the builder is
# limited by Dockerfile.python.dockerignore next to this file — BuildKit reads a Dockerfile-specific
# ignore file from the Dockerfile's directory, and a plain .dockerignore here would not apply to a
# context two levels up. Credentials and key stores are excluded there, and only the two directories
# the services need are copied below, so neither can end up in a layer.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY packages/mcp-vlei /app/packages/mcp-vlei
RUN pip install "mcp==2.2.0" /app/packages/mcp-vlei "fastapi==0.141.1" "uvicorn==0.53.0"

COPY examples/regulator /app/examples/regulator

# Fail the build rather than ship a secret: nothing key-shaped may be in the image.
RUN ! find /app -path '*/keys/*' -o -name '*.key' -o -path '*/credentials/*' | grep -q .

RUN useradd --system --uid 10001 --no-create-home vlei
USER vlei
